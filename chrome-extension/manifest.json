{
  "manifest_version": 3,
  "name": "TARS UI Inspector Collector",
  "version": "0.3.1",
  "description": "采集当前网页的可见截图、文字样式和布局属性，发送到本地 TARS UI Inspector。",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["http://localhost:3001/*", "http://127.0.0.1:3001/*"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "TARS UI Inspector Collector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  }
}
