{
  "manifest_version": 3,
  "name": "TARS UI Inspector Collector",
  "version": "0.1.0",
  "description": "采集当前网页的可见文字样式和布局属性，发送到本地 TARS UI Inspector。",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "action": {
    "default_title": "TARS UI Inspector Collector",
    "default_popup": "popup.html"
  }
}
